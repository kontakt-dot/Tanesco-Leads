# Tanesco Leads – Umgebungsvariablen (Kopie als .env für lokalen Betrieb; beim Hosting als Variablen hinterlegen)

# Pflicht
DATABASE_URL=mysql://benutzer:passwort@host:3306/tanesco_leads   # MySQL 8 oder TiDB
JWT_SECRET=bitte-einen-langen-zufaelligen-wert-eintragen         # signiert Sitzungen und verschlüsselt Integrationsschlüssel
APP_URL=https://leads.example.de                                 # öffentliche Adresse der Anwendung (für Datei-Links)

# KI-Funktionen (Kategorie-, Automatisierungs- und Integrations-Builder, Assistent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gesprächsbewertung (Sprache → Text): einer von beiden reicht; ohne Schlüssel muss der Dialer das Transkript mitliefern
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
DEEPGRAM_API_KEY=

# Telefonie (Dialer): Predictive-Takt in Sekunden (0 = aus). Twilio-Zugangsdaten werden in der Software hinterlegt (Telefonie → Einstellungen).
DIALER_TICK_SECONDS=5

# Betrieb
PORT=3000
NODE_ENV=production
UPLOAD_DIR=uploads                                               # Ablage für hochgeladene Dateien (beim Hosting ein dauerhaftes Volume)
DELIVERY_SCHEDULER_INTERVAL_MINUTES=15                           # Zeitplaner für Lieferintervalle/Wiederholungen (0 = aus)
REGISTRATION_OPEN=false                                          # true: jeder darf ein Konto anlegen; false: nur der erste Benutzer und Einladungen
CRON_SECRET=                                                     # optional: Schutz für POST /api/scheduled/integration-health (Header x-cron-secret)
MAIL_WEBHOOK_SECRET=                                             # optional: Schutz für den Bounce-/Beschwerde-Webhook POST /api/mail/bounce (?secret=… oder Header x-webhook-secret)

# Optional: Stripe für den Marktplatz-Kauf
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
